        var spiderWidth = spider.offsetWidth;
        var spiderHeight = spider.offsetHeight;
        var offsetLeft = e.offsetX - spiderWidth / 2;
        var offsetTop = e.offsetY - spiderHeight / 2;
        offsetLeft = Math.max(0, Math.min(offsetLeft, wall.clientWidth - spiderWidth));
        offsetTop = Math.max(0, Math.min(offsetTop, wall.clientHeight - spiderHeight));
